\@writefile{toc}{\contentsline {section}{\numberline {4}The Sample Size vs. Scale Dilemma (The Finite Thickness Paradox)}{6}{section.4}\protected@file@percent }
\newlabel{sec:sample_size_dilemma}{{4}{6}{The Sample Size vs. Scale Dilemma (The Finite Thickness Paradox)}{section.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The Sample Size Dilemma at Fixed $K = 8$.} Columns display increasing sample sizes ($N = 5\,000, 10\,000, 20\,000$), while rows show proper times $\tau = 0.25, 0.50, 1.00\,\mathrm  {fm}/c$. As $N$ grows at fixed $K=8$, the local ball radius shrinks below the transverse bundle thickness, causing the attractor points to appear 2-dimensional (purple) even at late times $\tau = 1.00\,\mathrm  {fm}/c$. This proves that $K$ must scale with $N$ according to $K_{\mathrm  {opt}} \propto N^{0.45}\sqrt  {D}$.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:sample_size_comparison}{{2}{7}{\textbf {The Sample Size Dilemma at Fixed $K = 8$.} Columns display increasing sample sizes ($N = 5\,000, 10\,000, 20\,000$), while rows show proper times $\tau = 0.25, 0.50, 1.00\,\mathrm {fm}/c$. As $N$ grows at fixed $K=8$, the local ball radius shrinks below the transverse bundle thickness, causing the attractor points to appear 2-dimensional (purple) even at late times $\tau = 1.00\,\mathrm {fm}/c$. This proves that $K$ must scale with $N$ according to $K_{\mathrm {opt}} \propto N^{0.45}\sqrt {D}$}{figure.caption.4}{}}
