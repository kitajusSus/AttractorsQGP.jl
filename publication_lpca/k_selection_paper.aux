\newlabel{fig:hjsw_phase_space}{{4a}{10}{3D Phase Space in physical units ($T\,[\mathrm {MeV}], \mathcal {A}, \mathcal {B}$)}{figure.caption.7}{}}
\newlabel{sub@fig:hjsw_phase_space}{{a}{10}{3D Phase Space in physical units ($T\,[\mathrm {MeV}], \mathcal {A}, \mathcal {B}$)}{figure.caption.7}{}}
\newlabel{fig:hjsw_histograms}{{4b}{10}{Stacked histograms of $d_{\mathrm {PR}}$ (binned by initial $\mathcal {A}$)}{figure.caption.7}{}}
