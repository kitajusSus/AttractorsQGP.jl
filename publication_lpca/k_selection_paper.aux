\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Hydrodynamic collapse in the 3D HJSW Model in physical units ($K = 100$).} (a) 3D phase-space trajectory cloud displaying physical coordinates on all axes ($T \in [100, 1000]\,\mathrm  {MeV}$, $\mathcal  {A} \in [-1, 2.5]$, $\mathcal  {B} \in [-1, 1]$), with points colored by the local PR dimension $d_{\mathrm  {PR}}$ computed via $Z$-score standardized local PCA ($K = 100$). (b) Stacked histograms of local dimension $d_{\mathrm  {PR}}$ demonstrating the two-stage collapse: the 3D volume at $\tau = 0.20\,\mathrm  {fm}/c$ ($\langle d_{\mathrm  {PR}} \rangle = 2.82 \pm 0.17$, $94.2\%$ with $d_{\mathrm  {PR}} > 2.5$) contracts rapidly as the fast non-hydrodynamic mode $\mathcal  {B}$ decays into an intermediate 2D sheet ($d \approx 2.0$) at $\tau = 0.25\,\mathrm  {fm}/c$, before collapsing toward the 1D hydrodynamic attractor ($d \to 1.0$) at late times.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:hjsw_overview}{{4}{10}{\textbf {Hydrodynamic collapse in the 3D HJSW Model in physical units ($K = 100$).} (a) 3D phase-space trajectory cloud displaying physical coordinates on all axes ($T \in [100, 1000]\,\mathrm {MeV}$, $\mathcal {A} \in [-1, 2.5]$, $\mathcal {B} \in [-1, 1]$), with points colored by the local PR dimension $d_{\mathrm {PR}}$ computed via $Z$-score standardized local PCA ($K = 100$). (b) Stacked histograms of local dimension $d_{\mathrm {PR}}$ demonstrating the two-stage collapse: the 3D volume at $\tau = 0.20\,\mathrm {fm}/c$ ($\langle d_{\mathrm {PR}} \rangle = 2.82 \pm 0.17$, $94.2\%$ with $d_{\mathrm {PR}} > 2.5$) contracts rapidly as the fast non-hydrodynamic mode $\mathcal {B}$ decays into an intermediate 2D sheet ($d \approx 2.0$) at $\tau = 0.25\,\mathrm {fm}/c$, before collapsing toward the 1D hydrodynamic attractor ($d \to 1.0$) at late times}{figure.caption.7}{}}
