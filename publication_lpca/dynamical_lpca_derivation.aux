\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Geometric mechanism of the curvature sagitta artifact.} (a) A circular neighborhood on a curved attractor arc $n(s) \approx \frac  {1}{2}\kappa s^2$. The longitudinal extent spans $L \propto k/N$, while the normal deflection (sagitta) scales quadratically as $\delta _{\mathrm  {sagitta}} \approx \frac  {1}{2}\kappa L^2 \propto (k/N)^2$. (b) Resulting LPCA covariance ellipses across neighborhood size regimes: small $k$ ($k < 12D$) is dominated by isotropic sampling noise floor ($d_{\mathrm  {PR}} \to 2$); optimal $k = K_{\mathrm  {opt}}$ forms an ultra-thin 1D needle ($d_{\mathrm  {PR}} \equiv 1.00$); excessive $k > 200$ is inflated by extrinsic curvature bending into an artificial 2D ellipse ($d_{\mathrm  {PR}} > 1$).}}{9}{figure.caption.3}\protected@file@percent }
\newlabel{fig:curvature_sagitta_schematic}{{2}{9}{\textbf {Geometric mechanism of the curvature sagitta artifact.} (a) A circular neighborhood on a curved attractor arc $n(s) \approx \frac {1}{2}\kappa s^2$. The longitudinal extent spans $L \propto k/N$, while the normal deflection (sagitta) scales quadratically as $\delta _{\mathrm {sagitta}} \approx \frac {1}{2}\kappa L^2 \propto (k/N)^2$. (b) Resulting LPCA covariance ellipses across neighborhood size regimes: small $k$ ($k < 12D$) is dominated by isotropic sampling noise floor ($d_{\mathrm {PR}} \to 2$); optimal $k = K_{\mathrm {opt}}$ forms an ultra-thin 1D needle ($d_{\mathrm {PR}} \equiv 1.00$); excessive $k > 200$ is inflated by extrinsic curvature bending into an artificial 2D ellipse ($d_{\mathrm {PR}} > 1$)}{figure.caption.3}{}}
\newlabel{eq:u_curve_formula}{{49}{9}{The Noise-Curvature Trade-Off: The U-Curve Valley}{equation.49}{}}
\newlabel{eq:k_opt_heuristic}{{51}{9}{The Noise-Curvature Trade-Off: The U-Curve Valley}{equation.51}{}}
