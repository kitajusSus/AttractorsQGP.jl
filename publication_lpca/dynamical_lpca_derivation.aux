\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Verification of Covariance Damping Rate (Hypothesis 1)}{9}{subsection.7.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Comprehensive eigenvalue spectrum and optimal neighborhood identification on the MIS attractor ($\tau = 2.0\,\mathrm  {fm}/c, N = 10\,000$).} (a) Individual eigenvalues $\lambda _1(k)$ (tangent, blue) scaling as $\propto k^2$ and $\lambda _2(k)$ (transverse, red) transitioning from a noise plateau into quadratic sagitta growth $\propto k^4$. (b) The eigenvalue ratio $\lambda _2(k)/\lambda _1(k)$ displaying the characteristic U-curve: steep decay $\propto k^{-1.82}$ in the noise-dominated regime, followed by a flat minimum at $K_{\mathrm  {opt}} = 128$ ($\lambda _2/\lambda _1 = 9.31\times 10^{-6}$), and quadratic inflation $\propto k^{+1.80}$ in the curvature-dominated regime. (c) Local Participation Ratio dimension $\langle d_{\mathrm  {PR}} \rangle $ with $\pm 1\sigma $ band, showing exact plateau $d_{\mathrm  {PR}} \equiv 1.0000$ throughout $k \in [64, 192]$. (d) Optimization diagnostics: scale sensitivity $S(k) = |\partial \langle d \rangle / \partial \ln k|$ and standard deviation $\sigma (d_{\mathrm  {PR}})$ vanishing at the optimal plateau, validating the heuristic rule $K_{\mathrm  {rule}} \approx 89$--$120$.}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:eigenvalues_u_curve}{{3}{10}{\textbf {Comprehensive eigenvalue spectrum and optimal neighborhood identification on the MIS attractor ($\tau = 2.0\,\mathrm {fm}/c, N = 10\,000$).} (a) Individual eigenvalues $\lambda _1(k)$ (tangent, blue) scaling as $\propto k^2$ and $\lambda _2(k)$ (transverse, red) transitioning from a noise plateau into quadratic sagitta growth $\propto k^4$. (b) The eigenvalue ratio $\lambda _2(k)/\lambda _1(k)$ displaying the characteristic U-curve: steep decay $\propto k^{-1.82}$ in the noise-dominated regime, followed by a flat minimum at $K_{\mathrm {opt}} = 128$ ($\lambda _2/\lambda _1 = 9.31\times 10^{-6}$), and quadratic inflation $\propto k^{+1.80}$ in the curvature-dominated regime. (c) Local Participation Ratio dimension $\langle d_{\mathrm {PR}} \rangle $ with $\pm 1\sigma $ band, showing exact plateau $d_{\mathrm {PR}} \equiv 1.0000$ throughout $k \in [64, 192]$. (d) Optimization diagnostics: scale sensitivity $S(k) = |\partial \langle d \rangle / \partial \ln k|$ and standard deviation $\sigma (d_{\mathrm {PR}})$ vanishing at the optimal plateau, validating the heuristic rule $K_{\mathrm {rule}} \approx 89$--$120$}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Evolution of local covariance eigenvalues and Participation Ratio dimension across proper time $\tau $ ($r_0 = 10^{-4}$).}}{10}{table.caption.6}\protected@file@percent }
\newlabel{tab:test1_results}{{1}{10}{Evolution of local covariance eigenvalues and Participation Ratio dimension across proper time $\tau $ ($r_0 = 10^{-4}$)}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {High-resolution eigenvalue ratio $\lambda _1/\lambda _2$ across neighborhood size $K$ complying with the publication theme.} (a) Inversion of the U-curve at late attractor time ($\tau = 2.0\,\mathrm  {fm}/c, N = 10\,000$). The ratio peaks at $K_{\mathrm  {opt}} = 128$ reaching $\lambda _1/\lambda _2 \approx 1.1\times 10^5$, demarcating the optimal dimensional resolution plateau $K \in [64, 192]$ (soft shaded region). Dashed guide lines indicate the finite-sample noise scaling $\propto K^{+1.82}$ and the curvature sagitta scaling $\propto K^{-1.80}$. (b) Dynamic emergence of the attractor peak across proper times $\tau \in [0.25, 2.00]\,\mathrm  {fm}/c$, showing monotonic growth over four orders of magnitude as non-hydrodynamic modes decay.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ratio_lambda1_lambda2_subtle}{{4}{11}{\textbf {High-resolution eigenvalue ratio $\lambda _1/\lambda _2$ across neighborhood size $K$ complying with the publication theme.} (a) Inversion of the U-curve at late attractor time ($\tau = 2.0\,\mathrm {fm}/c, N = 10\,000$). The ratio peaks at $K_{\mathrm {opt}} = 128$ reaching $\lambda _1/\lambda _2 \approx 1.1\times 10^5$, demarcating the optimal dimensional resolution plateau $K \in [64, 192]$ (soft shaded region). Dashed guide lines indicate the finite-sample noise scaling $\propto K^{+1.82}$ and the curvature sagitta scaling $\propto K^{-1.80}$. (b) Dynamic emergence of the attractor peak across proper times $\tau \in [0.25, 2.00]\,\mathrm {fm}/c$, showing monotonic growth over four orders of magnitude as non-hydrodynamic modes decay}{figure.caption.5}{}}
